# Environment for local development. The application always runs on the host, so
# these values also apply to `make dockerrun`, which uses --net=host.
# Copied to .env (gitignored) by `make setup`; edit that copy, or add a .env.local.

PYGEOAPI_CONFIG=./pygeoapi-config.yml
PYGEOAPI_OPENAPI=./pygeoapi-openapi.yml

# PostGIS is provided by this repo's docker-compose.yml (`make services-up`).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swissgeo
DB_USER=swissgeo
DB_PW=swissgeo

# Traces go to the collector from docker-compose.yml, in plaintext.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
HTML_ENABLED=true
